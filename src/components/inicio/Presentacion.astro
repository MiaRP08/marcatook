---
// Sección: Presentación con Carrusel Manual de 3 fotos (FTM, FTM1, FTM2)
const fotosPresentacion = [
  {
    archivo: "/pack/imagenes/FTM.jpeg",
    alt: "Sesión fotográfica en estudio FTM - TAKE, TOOK & TAKEN",
  },
  {
    archivo: "/pack/imagenes/FTM1.jpeg",
    alt: "Sesión fotográfica en estudio FTM 1 - TAKE, TOOK & TAKEN",
  },
  {
    archivo: "/pack/imagenes/FTM2.jpeg",
    alt: "Sesión fotográfica en estudio FTM 2 - TAKE, TOOK & TAKEN",
  },
];
---

<section class="border-t border-[#A19E97]/40 bg-[#E9DED3] py-16 text-[#212220] md:py-24">
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-14">
      <!-- Columna Izquierda: Textos y Botón -->
      <div class="flex flex-col justify-center space-y-6 text-left lg:col-span-7">
        <h2
          class="font-['Oswald',sans-serif] text-3xl leading-[1.15] font-bold tracking-tight text-[#212220] sm:text-4xl lg:text-5xl"
        >
          Más que fotografías, creamos recuerdos.
        </h2>

        <div
          class="space-y-4 font-['Lora',serif] text-base leading-relaxed text-[#212220]/90 sm:text-lg"
        >
          <p>
            Somos TAKE, TOOK & TAKEN, un estudio creativo de fotografía personalizada donde cada
            idea es una oportunidad para crear algo extraordinario. Nos encanta experimentar con
            estilos, colores, emociones y composiciones para conseguir fotografías que se alejen de
            lo convencional.
          </p>

          <p>
            Creemos que cada persona tiene una esencia diferente y que cada fotografía debe
            reflejarla de una manera única.
          </p>
        </div>

        <div class="pt-2">
          <a
            href="/nosotros"
            class="inline-flex items-center justify-center rounded-[8px] bg-[#405A46] px-7 py-3.5 text-center font-['Plus_Jakarta_Sans',sans-serif] text-sm font-semibold tracking-wider text-[#FFFFFF] uppercase shadow-[0_4px_12px_rgb(0,0,0,0.12)] transition-all duration-300 hover:opacity-90 active:scale-[0.98]"
          >
            CONOCE NUESTRA HISTORIA
          </a>
        </div>
      </div>

      <!-- Columna Derecha: Carrusel Manual de 3 fotos -->
      <div class="flex w-full justify-center lg:col-span-5">
        <div
          id="carrusel-manual-presentacion"
          class="group relative aspect-[4/5] w-full max-w-md overflow-hidden rounded-[8px] border border-[#A19E97] bg-[#F1F1DB] shadow-[0_4px_12px_rgb(0,0,0,0.12)] sm:aspect-square"
          aria-label="Carrusel de fotos de presentación"
        >
          <!-- Diapositivas -->
          {
            fotosPresentacion.map((foto, index) => (
              <div
                class={`diapositiva-manual absolute inset-0 transition-opacity duration-500 ease-in-out ${index === 0 ? "z-10 opacity-100" : "z-0 opacity-0"}`}
                data-indice={index}
              >
                <img
                  src={foto.archivo}
                  alt={foto.alt}
                  loading={index === 0 ? "eager" : "lazy"}
                  class="h-full w-full object-cover object-center"
                />
              </div>
            ))
          }

          <!-- Flecha Izquierda (Anterior) -->
          <button
            type="button"
            id="btn-manual-anterior"
            class="text-white absolute top-1/2 left-3 z-20 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-[#212220]/60 backdrop-blur-sm transition-all duration-300 hover:bg-[#212220]/90 focus:outline-none active:scale-90"
            aria-label="Foto anterior"
          >
            <svg
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="2.5"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
            </svg>
          </button>

          <!-- Flecha Derecha (Siguiente) -->
          <button
            type="button"
            id="btn-manual-siguiente"
            class="text-white absolute top-1/2 right-3 z-20 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-[#212220]/60 backdrop-blur-sm transition-all duration-300 hover:bg-[#212220]/90 focus:outline-none active:scale-90"
            aria-label="Siguiente foto"
          >
            <svg
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="2.5"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
            </svg>
          </button>

          <!-- Puntos Indicadores Inferiores -->
          <div
            class="absolute bottom-4 left-1/2 z-20 flex -translate-x-1/2 items-center space-x-2 rounded-full bg-[#212220]/60 px-3.5 py-1.5 backdrop-blur-sm"
            role="tablist"
            aria-label="Puntos del carrusel"
          >
            {
              fotosPresentacion.map((_, index) => (
                <button
                  type="button"
                  class={`punto-manual h-2 rounded-full transition-all duration-300 ${index === 0 ? "w-6 bg-[#FFFFFF]" : "w-2 bg-[#FFFFFF]/50 hover:bg-[#FFFFFF]/80"}`}
                  data-diapositiva={index}
                  aria-label={`Ver foto ${index + 1}`}
                />
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupCarruselManual() {
    const contenedor = document.getElementById("carrusel-manual-presentacion");
    if (!contenedor) return;

    const diapositivas = contenedor.querySelectorAll<HTMLElement>(".diapositiva-manual");
    const puntos = contenedor.querySelectorAll<HTMLElement>(".punto-manual");
    const btnAnterior = document.getElementById("btn-manual-anterior");
    const btnSiguiente = document.getElementById("btn-manual-siguiente");
    const total = diapositivas.length;
    let indiceActual = 0;

    function irADiapositiva(nuevoIndice: number) {
      diapositivas.forEach((diapositiva, i) => {
        if (i === nuevoIndice) {
          diapositiva.classList.remove("opacity-0", "z-0");
          diapositiva.classList.add("opacity-100", "z-10");
        } else {
          diapositiva.classList.remove("opacity-100", "z-10");
          diapositiva.classList.add("opacity-0", "z-0");
        }
      });

      puntos.forEach((punto, i) => {
        if (i === nuevoIndice) {
          punto.classList.remove("bg-[#FFFFFF]/50", "w-2");
          punto.classList.add("bg-[#FFFFFF]", "w-6");
        } else {
          punto.classList.remove("bg-[#FFFFFF]", "w-6");
          punto.classList.add("bg-[#FFFFFF]/50", "w-2");
        }
      });

      indiceActual = nuevoIndice;
    }

    btnAnterior?.addEventListener("click", () => {
      const nuevo = (indiceActual - 1 + total) % total;
      irADiapositiva(nuevo);
    });

    btnSiguiente?.addEventListener("click", () => {
      const nuevo = (indiceActual + 1) % total;
      irADiapositiva(nuevo);
    });

    puntos.forEach((punto, idx) => {
      punto.addEventListener("click", () => {
        irADiapositiva(idx);
      });
    });
  }

  document.addEventListener("DOMContentLoaded", setupCarruselManual);
  document.addEventListener("astro:page-load", setupCarruselManual);
</script>
