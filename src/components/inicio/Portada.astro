---
const fotografias = [
  { archivo: "/pack/imagenes/FT01.jpeg", alt: "Fotografía personalizada 1 - TAKE, TOOK & TAKEN" },
  { archivo: "/pack/imagenes/FT02.jpeg", alt: "Fotografía personalizada 2 - TAKE, TOOK & TAKEN" },
  { archivo: "/pack/imagenes/FT03.jpeg", alt: "Fotografía personalizada 3 - TAKE, TOOK & TAKEN" },
  { archivo: "/pack/imagenes/FT04.jpeg", alt: "Fotografía personalizada 4 - TAKE, TOOK & TAKEN" },
];
---

<section class="bg-[#E9DED3] py-12 text-[#212220] md:py-16 lg:py-24">
  <!-- Contenedor max-w-7xl directo -->
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <!-- Columna Izquierda: Información Editorial y Acciones -->
      <div class="flex flex-col justify-center space-y-6 text-left">
        <h1
          class="font-['Oswald',sans-serif] text-4xl leading-[1.1] font-bold tracking-tight text-[#212220] sm:text-5xl lg:text-6xl"
        >
          Atrévete a verte diferente.
        </h1>

        <p class="font-['Lora',serif] text-base leading-relaxed text-[#212220] sm:text-lg">
          Cada fotografía tiene una historia y cada persona tiene una esencia única. En TAKE, TOOK &
          TAKEN transformamos tus ideas en fotografías llenas de creatividad, estilo y personalidad.
          Nos apasiona capturar momentos especiales y convertirlos en imágenes auténticas que
          reflejen quién eres.
        </p>

        <p class="pt-1 font-['Lora',serif] text-lg font-medium text-[#5F5A54] italic sm:text-xl">
          No tomamos fotos, creamos recuerdos increíbles.
        </p>

        <!-- Botones de Navegación -->
        <div class="flex flex-col items-stretch gap-4 pt-2 sm:flex-row sm:items-center">
          <a
            href="/proyectos"
            class="inline-flex items-center justify-center rounded-[8px] bg-[#405A46] px-7 py-3.5 text-center font-['Plus_Jakarta_Sans',sans-serif] text-sm font-semibold tracking-wider text-[#FFFFFF] uppercase shadow-[0_4px_12px_rgb(0,0,0,0.12)] transition-all duration-300 hover:opacity-90 active:scale-[0.98]"
          >
            VER NUESTRO TRABAJO
          </a>
          <a
            href="/nosotros"
            class="inline-flex items-center justify-center rounded-[8px] border border-[#A19E97] bg-[#F1F1DB] px-7 py-3.5 text-center font-['Plus_Jakarta_Sans',sans-serif] text-sm font-semibold tracking-wider text-[#212220] uppercase transition-all duration-300 hover:bg-[#E9DED3] active:scale-[0.98]"
          >
            CONÓCENOS
          </a>
        </div>
      </div>

      <!-- Columna Derecha: Carrusel Fotográfico -->
      <div class="flex w-full justify-center">
        <div
          id="carrusel-portada"
          class="relative aspect-[4/5] max-h-[560px] w-full overflow-hidden rounded-[8px] border border-[#A19E97] bg-[#F1F1DB] shadow-[0_4px_12px_rgb(0,0,0,0.12)] sm:aspect-[3/4]"
        >
          {
            fotografias.map((foto, index) => (
              <div
                class={`diapositiva-carrusel absolute inset-0 transition-opacity duration-700 ease-in-out ${index === 0 ? "z-10 opacity-100" : "z-0 opacity-0"}`}
                data-indice={index}
              >
                <img
                  src={foto.archivo}
                  alt={foto.alt}
                  loading={index === 0 ? "eager" : "lazy"}
                  class="h-full w-full object-cover object-center"
                />
              </div>
            ))
          }

          <!-- Indicadores del carrusel -->
          <div
            class="absolute bottom-4 left-1/2 z-20 flex -translate-x-1/2 items-center space-x-2 rounded-full bg-[#212220]/50 px-3 py-1.5 backdrop-blur-sm"
          >
            {
              fotografias.map((_, index) => (
                <button
                  type="button"
                  class={`indicador-carrusel h-2 rounded-full transition-all duration-300 ${index === 0 ? "w-6 bg-[#FFFFFF]" : "w-2 bg-[#FFFFFF]/50 hover:bg-[#FFFFFF]/80"}`}
                  data-diapositiva={index}
                  aria-label={`Mostrar imagen ${index + 1}`}
                />
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupCarrusel() {
    const contenedor = document.getElementById("carrusel-portada");
    if (!contenedor) return;

    const diapositivas = contenedor.querySelectorAll<HTMLElement>(".diapositiva-carrusel");
    const indicadores = contenedor.querySelectorAll<HTMLElement>(".indicador-carrusel");
    const total = diapositivas.length;
    let indiceActual = 0;
    let temporizador: number | undefined;

    function cambiarDiapositiva(nuevoIndice: number) {
      diapositivas.forEach((diapositiva, i) => {
        if (i === nuevoIndice) {
          diapositiva.classList.remove("opacity-0", "z-0");
          diapositiva.classList.add("opacity-100", "z-10");
        } else {
          diapositiva.classList.remove("opacity-100", "z-10");
          diapositiva.classList.add("opacity-0", "z-0");
        }
      });

      indicadores.forEach((indicador, i) => {
        if (i === nuevoIndice) {
          indicador.classList.remove("bg-[#FFFFFF]/50", "w-2");
          indicador.classList.add("bg-[#FFFFFF]", "w-6");
        } else {
          indicador.classList.remove("bg-[#FFFFFF]", "w-6");
          indicador.classList.add("bg-[#FFFFFF]/50", "w-2");
        }
      });

      indiceActual = nuevoIndice;
    }

    function siguiente() {
      const siguienteIndice = (indiceActual + 1) % total;
      cambiarDiapositiva(siguienteIndice);
    }

    function reiniciarIntervalo() {
      if (temporizador) clearInterval(temporizador);
      temporizador = window.setInterval(siguiente, 5000);
    }

    indicadores.forEach((boton, index) => {
      boton.addEventListener("click", () => {
        cambiarDiapositiva(index);
        reiniciarIntervalo();
      });
    });

    reiniciarIntervalo();
  }

  document.addEventListener("DOMContentLoaded", setupCarrusel);
  document.addEventListener("astro:page-load", setupCarrusel);
</script>
