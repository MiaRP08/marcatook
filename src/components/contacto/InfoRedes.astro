---
// Sección: Información de contacto y Redes Sociales con enlaces oficiales
const canales = [
  {
    nombre: "Instagram",
    etiqueta: "@taketooktaken",
    enlace: "https://www.instagram.com/mia_1rp?vrfl=NnltOWVpOGowMW15",
    icono: "instagram",
  },
  {
    nombre: "WhatsApp",
    etiqueta: "Chat directo",
    enlace: "https://wa.me/qr/7X2ZOL5RI447B1?s=r",
    icono: "whatsapp",
  },
  {
    nombre: "Correo electrónico",
    etiqueta: "Contáctame",
    correoTexto: "miaraphaellarp@gmail.com",
    enlace: "mailto:miaraphaellarp@gmail.com",
    icono: "correo",
  },
];

const contenido = {
  titulo: "¡Conectemos!",
  texto:
    "Síguenos en nuestras redes sociales o escríbenos directamente. Nos encantará conocer tus ideas y ayudarte a crear fotografías increíbles.",
};
---

<section class="border-t border-[#A19E97]/40 bg-[#E9DED3] py-16 text-[#212220] md:py-24">
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Encabezado Centrado -->
    <div class="mx-auto mb-12 flex max-w-3xl flex-col items-center space-y-4 text-center">
      <span
        class="font-['Plus_Jakarta_Sans',sans-serif] text-xs font-semibold tracking-widest text-[#5F5A54] uppercase"
      >
        Canales directos
      </span>

      <h2
        class="font-['Oswald',sans-serif] text-3xl leading-[1.15] font-bold tracking-tight text-[#212220] sm:text-4xl lg:text-5xl"
      >
        {contenido.titulo}
      </h2>

      <p
        class="max-w-xl pt-1 font-['Lora',serif] text-base leading-relaxed text-[#212220]/90 sm:text-lg"
      >
        {contenido.texto}
      </p>
    </div>

    <!-- Canales de Comunicación -->
    <div class="mx-auto grid max-w-4xl grid-cols-1 gap-6 sm:grid-cols-3">
      <!-- 1. Instagram -->
      <a
        href={canales[0].enlace}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex flex-col items-center rounded-[8px] border border-[#A19E97] bg-[#F1F1DB] p-6 text-center shadow-[0_4px_12px_rgb(0,0,0,0.12)] transition-all duration-300 hover:-translate-y-1 hover:border-[#405A46]"
      >
        <div
          class="mb-4 flex h-12 w-12 items-center justify-center rounded-full border border-[#A19E97]/60 bg-[#E9DED3] text-[#405A46] transition-colors duration-300 group-hover:bg-[#405A46] group-hover:text-[#FFFFFF]"
        >
          <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill-rule="evenodd"
              d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z"
              clip-rule="evenodd"></path>
          </svg>
        </div>
        <span
          class="mb-1 font-['Oswald',sans-serif] text-lg font-bold tracking-wide text-[#212220]"
        >
          {canales[0].nombre}
        </span>
        <span
          class="font-['Plus_Jakarta_Sans',sans-serif] text-xs font-medium text-[#5F5A54] transition-colors group-hover:text-[#405A46]"
        >
          {canales[0].etiqueta}
        </span>
      </a>

      <!-- 2. WhatsApp -->
      <a
        href={canales[1].enlace}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex flex-col items-center rounded-[8px] border border-[#A19E97] bg-[#F1F1DB] p-6 text-center shadow-[0_4px_12px_rgb(0,0,0,0.12)] transition-all duration-300 hover:-translate-y-1 hover:border-[#405A46]"
      >
        <div
          class="mb-4 flex h-12 w-12 items-center justify-center rounded-full border border-[#A19E97]/60 bg-[#E9DED3] text-[#405A46] transition-colors duration-300 group-hover:bg-[#405A46] group-hover:text-[#FFFFFF]"
        >
          <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
            ></path>
          </svg>
        </div>
        <span
          class="mb-1 font-['Oswald',sans-serif] text-lg font-bold tracking-wide text-[#212220]"
        >
          {canales[1].nombre}
        </span>
        <span
          class="font-['Plus_Jakarta_Sans',sans-serif] text-xs font-medium text-[#5F5A54] transition-colors group-hover:text-[#405A46]"
        >
          {canales[1].etiqueta}
        </span>
      </a>

      <!-- 3. Correo Electrónico: Contáctame -> mailto:miaraphaellarp@gmail.com -->
      <a
        href={canales[2].enlace}
        class="group flex flex-col items-center rounded-[8px] border border-[#A19E97] bg-[#F1F1DB] p-6 text-center shadow-[0_4px_12px_rgb(0,0,0,0.12)] transition-all duration-300 hover:-translate-y-1 hover:border-[#405A46]"
      >
        <div
          class="mb-4 flex h-12 w-12 items-center justify-center rounded-full border border-[#A19E97]/60 bg-[#E9DED3] text-[#405A46] transition-colors duration-300 group-hover:bg-[#405A46] group-hover:text-[#FFFFFF]"
        >
          <svg
            class="h-6 w-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="1.75"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
            ></path>
          </svg>
        </div>
        <span
          class="mb-1 font-['Oswald',sans-serif] text-lg font-bold tracking-wide text-[#212220]"
        >
          {canales[2].nombre}
        </span>
        <span
          class="font-['Plus_Jakarta_Sans',sans-serif] text-sm font-bold text-[#405A46] transition-all group-hover:underline"
        >
          {canales[2].etiqueta}
        </span>
        <span class="mt-1 font-['Lora',serif] text-xs break-all text-[#5F5A54]">
          {canales[2].correoTexto}
        </span>
      </a>
    </div>
  </div>
</section>
