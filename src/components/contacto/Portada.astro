---
// Sección: Portada de Contacto con el Logo de la marca
const datosPortada = {
  etiqueta: "Contacto & Reservas",
  titulo: "Hagamos algo increíble juntos.",
  texto:
    "¿Tienes una idea en mente? Nos encantaría escucharla. Escríbenos y comencemos a crear fotografías que cuenten tu historia.",
  imagen: "/pack/logos/logo.jpeg",
  alt: "Logotipo oficial de TAKE, TOOK & TAKEN",
};
---

<section class="bg-[#E9DED3] py-12 text-[#212220] md:py-16 lg:py-24">
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-14">
      <!-- Bloque del Logo: Superior en móvil, Columna derecha en computadora -->
      <div class="order-1 flex w-full justify-center lg:order-2 lg:col-span-5">
        <div
          class="flex aspect-[4/3] w-full max-w-md items-center justify-center overflow-hidden rounded-[8px] border border-[#A19E97] bg-[#F1F1DB] p-8 shadow-[0_4px_12px_rgb(0,0,0,0.12)] sm:aspect-square sm:p-12"
        >
          <img
            src={datosPortada.imagen}
            alt={datosPortada.alt}
            loading="eager"
            class="max-h-full max-w-full object-contain"
          />
        </div>
      </div>

      <!-- Bloque de Texto: Columna izquierda en computadora -->
      <div
        class="order-2 flex flex-col justify-center space-y-6 text-left lg:order-1 lg:col-span-7"
      >
        <span
          class="font-['Plus_Jakarta_Sans',sans-serif] text-xs font-semibold tracking-widest text-[#5F5A54] uppercase"
        >
          {datosPortada.etiqueta}
        </span>

        <h1
          class="font-['Oswald',sans-serif] text-4xl leading-[1.1] font-bold tracking-tight text-[#212220] sm:text-5xl lg:text-6xl"
        >
          {datosPortada.titulo}
        </h1>

        <p class="pt-2 font-['Lora',serif] text-base leading-relaxed text-[#212220]/90 sm:text-lg">
          {datosPortada.texto}
        </p>

        <!-- Detalle de estilo editorial -->
        <div class="border-l-2 border-[#405A46] pt-2 pl-4">
          <p class="font-['Lora',serif] text-sm text-[#5F5A54] italic sm:text-base">
            "Cuéntanos qué imaginas y juntas crearemos algo especial."
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
