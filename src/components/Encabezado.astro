---
// Barra de navegación con el color café (#5F5A54) de tu paleta
const rutaActual = Astro.url.pathname;

const enlaces = [
  { texto: "Inicio", ruta: "/" },
  { texto: "Nosotros", ruta: "/nosotros" },
  { texto: "Proyectos", ruta: "/proyectos" },
  { texto: "Contacto", ruta: "/contacto" },
];
---

<header
  class="sticky top-0 z-50 w-full border-b border-[#A19E97] bg-[#5F5A54] shadow-md transition-all"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-20 items-center justify-between">
      <!-- Logo y Nombre de Marca -->
      <a href="/" class="group flex items-center space-x-3">
        <div
          class="flex h-11 w-11 items-center justify-center rounded-[8px] border border-[#A19E97] bg-[#F1F1DB] p-1 shadow-sm"
        >
          <img
            src="/pack/logos/logo.jpeg"
            alt="Logo TAKE, TOOK & TAKEN"
            class="max-h-full max-w-full object-contain"
          />
        </div>
        <span
          class="text-xl font-bold tracking-wider text-[#FFFFFF] uppercase transition-colors group-hover:text-[#F1F1DB] sm:text-2xl"
        >
          TAKE, TOOK & TAKEN
        </span>
      </a>

      <!-- Menú de Navegación en Computadora -->
      <nav class="hidden items-center space-x-3 md:flex">
        {
          enlaces.map((item) => {
            const esActivo =
              rutaActual === item.ruta || (item.ruta !== "/" && rutaActual.startsWith(item.ruta));
            return (
              <a
                href={item.ruta}
                class={`rounded-[8px] px-4 py-2 text-xs font-semibold tracking-widest uppercase transition-all duration-300 ${
                  esActivo
                    ? "bg-[#405A46] text-[#FFFFFF] shadow-sm"
                    : "hover:bg-white/15 text-[#FFFFFF] hover:text-[#FFFFFF]"
                }`}
              >
                {item.texto}
              </a>
            );
          })
        }
      </nav>

      <!-- Botón para Celular (Hamburguesa) -->
      <div class="flex md:hidden">
        <button
          type="button"
          id="btn-menu-movil"
          class="bg-white/10 hover:bg-white/20 rounded-[8px] p-2 text-[#FFFFFF] transition-colors"
          aria-label="Abrir menú"
        >
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Menú Desplegable en Celular -->
  <div
    id="menu-desplegable-movil"
    class="hidden space-y-2 border-t border-[#A19E97]/40 bg-[#5F5A54] px-6 py-4 md:hidden"
  >
    {
      enlaces.map((item) => (
        <a
          href={item.ruta}
          class="hover:bg-white/15 block rounded-[8px] px-4 py-2.5 text-sm font-semibold tracking-wider text-[#FFFFFF] uppercase"
        >
          {item.texto}
        </a>
      ))
    }
  </div>
</header>

<script>
  function setupMenu() {
    const btn = document.getElementById("btn-menu-movil");
    const menu = document.getElementById("menu-desplegable-movil");
    if (btn && menu) {
      btn.addEventListener("click", () => {
        menu.classList.toggle("hidden");
      });
    }
  }
  document.addEventListener("DOMContentLoaded", setupMenu);
  document.addEventListener("astro:page-load", setupMenu);
</script>
