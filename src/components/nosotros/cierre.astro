---
// Sección: Cierre de la página Nosotros (Boceto 2)
const frase = "Cada persona tiene una historia. Nosotras la convertimos en imagen.";
---

<section class="border-t border-[#A19E97]/40 bg-[#E9DED3] py-16 text-[#212220] md:py-24">
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Franja central destacada según Boceto 2 -->
    <div
      class="mx-auto flex max-w-4xl flex-col items-center rounded-[8px] border border-[#A19E97] bg-[#F1F1DB] p-8 text-center shadow-[0_4px_12px_rgb(0,0,0,0.12)] sm:p-12 lg:p-16"
    >
      <h2
        class="max-w-2xl font-['Oswald',sans-serif] text-2xl leading-snug font-bold tracking-tight text-[#212220] sm:text-3xl lg:text-4xl"
      >
        “{frase}”
      </h2>

      <div class="mt-8 sm:mt-10">
        <a
          href="/proyectos"
          class="inline-flex items-center justify-center rounded-[8px] bg-[#405A46] px-9 py-4 text-center font-['Plus_Jakarta_Sans',sans-serif] text-sm font-semibold tracking-wider text-[#FFFFFF] uppercase shadow-[0_4px_12px_rgb(0,0,0,0.12)] transition-all duration-300 hover:opacity-90 active:scale-[0.98]"
        >
          DESCUBRE NUESTRO TRABAJO
        </a>
      </div>
    </div>
  </div>
</section>
